# Public Supabase client configuration.
# Find these in Supabase Project Settings > API, or use local Supabase CLI output.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side Supabase configuration.
# SUPABASE_SERVICE_ROLE_KEY can hold either a modern sb_secret_ key or a legacy
# service_role JWT. It must never be exposed to browser code.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Current MVP object storage.
# Supabase PostgreSQL remains the authoritative structured-data store.
OBJECT_STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_BUCKET=reversepath-files

# Server-side AI routing.
# Use mock for no-cost deterministic local tests; use live when provider keys/models are configured.
AI_PROVIDER_MODE=mock
AI_PROVIDER_TIMEOUT_MS=90000
AI_PROVIDER_MAX_RETRIES=1
AI_PROVIDER_ALLOWLIST=gemini,groq,openrouter,openai
AI_ROUTE_FAST=groq,gemini,openrouter,openai
AI_ROUTE_PRIMARY=gemini,groq,openrouter,openai
AI_ROUTE_CRITIC=gemini,groq,openrouter,openai
AI_ROUTE_FALLBACK=gemini,groq,openrouter,openai

# Gemini.
# Get a key from Google AI Studio. Enable only when both key and model are configured.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL_DEFAULT=
GEMINI_MODEL_FAST=
GEMINI_MODEL_PRIMARY=
GEMINI_MODEL_CRITIC=
GEMINI_MODEL_FALLBACK=

# Groq.
# Get a key from Groq Console. Good fit for fast classification/clarification.
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_DEFAULT=
GROQ_MODEL_FAST=
GROQ_MODEL_PRIMARY=
GROQ_MODEL_CRITIC=
GROQ_MODEL_FALLBACK=

# OpenRouter.
# Get a key from OpenRouter and choose model slugs in the OpenRouter dashboard.
# Free/free-router model IDs change over time, so configure them here instead of hardcoding.
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=ReversePath
OPENROUTER_MODEL_DEFAULT=
OPENROUTER_MODEL_FAST=
OPENROUTER_MODEL_PRIMARY=
OPENROUTER_MODEL_CRITIC=
OPENROUTER_MODEL_FALLBACK=

# Optional paid fallback: OpenAI.
# Get a key from the OpenAI API platform. Leave disabled for free-first local development.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_DEFAULT=
OPENAI_MODEL_FAST=
OPENAI_MODEL_PRIMARY=
OPENAI_MODEL_CRITIC=
OPENAI_MODEL_FALLBACK=

# Optional Lovable-hosted compatible fallback.
LOVABLE_AI_ENABLED=false
LOVABLE_API_KEY=
LOVABLE_AI_BASE_URL=https://ai.gateway.lovable.dev/v1
LOVABLE_MODEL_DEFAULT=
LOVABLE_MODEL_FAST=
LOVABLE_MODEL_PRIMARY=
LOVABLE_MODEL_CRITIC=
LOVABLE_MODEL_FALLBACK=

# Application and cost-control configuration.
APP_ENV=local
PUBLIC_APP_URL=http://localhost:5173
AI_DAILY_REQUEST_LIMIT=10
AI_LIMIT_CLASSIFY_AND_CLARIFY_PER_DAY=
AI_LIMIT_GENERATE_PLAN_GRAPH_PER_DAY=
AI_LIMIT_REPLAN_PER_DAY=
AI_MAX_OUTPUT_TOKENS=12000
AI_GENERATION_ENABLED=true

# Optional live test gates.
# Normal automated tests do not require these and do not make paid AI calls.
RUN_LIVE_AI_SMOKE=false
RUN_SUPABASE_RLS_TESTS=false
RUN_E2E_GOLDEN=false
# Optional test overrides. Leave empty to use SUPABASE_URL,
# SUPABASE_PUBLISHABLE_KEY, and SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_TEST_URL=
SUPABASE_TEST_PUBLISHABLE_KEY=
SUPABASE_TEST_SECRET_KEY=
# Legacy compatibility only.
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=
PLAYWRIGHT_BASE_URL=
PLAYWRIGHT_PORT=4173
