# Public Supabase client configuration.
# Find these in Supabase Project Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side Supabase configuration.
# SUPABASE_SERVICE_ROLE_KEY must never be exposed to browser code.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-side AI configuration.
# ReversePath prefers OpenAI directly. Use OPENAI_BASE_URL only for a compatible proxy.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_FAST=
OPENAI_MODEL_PRIMARY=
OPENAI_MODEL_CRITIC=
OPENAI_MODEL_FALLBACK=

# Optional Lovable AI fallback for Lovable-hosted environments.
LOVABLE_API_KEY=

# Application and cost-control configuration.
APP_ENV=local
PUBLIC_APP_URL=http://localhost:5173
AI_DAILY_REQUEST_LIMIT=10
AI_MAX_OUTPUT_TOKENS=12000
AI_GENERATION_ENABLED=true
